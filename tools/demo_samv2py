import numpy as np

import sys

sys.path.append("tools")

from demo import get_random_query_point
from interfaces import init, get_embedding, get_sim_embed_loc
from utils import read_image
import torch

torch.manual_seed(1234)

config_file = "configs/samv2/samv2_ct_mri_infer.py"
checkpoint_file = "checkpoints/CrossSAM_iter_20000_ct_mr_inter_1.pth"

im1_file = "data/raw_data/NIH_lymph_node/ABD_LYMPH_001.nii.gz"
im1_isMRI = False
im2_file = "data/raw_data/MR/T2WI.nii.gz"
im2_isMRI = True  # T2


model = init(config_file, checkpoint_file)
im1, normed_im1, norm_info_1 = read_image(im1_file, is_MRI=im1_isMRI)
im2, normed_im2, norm_info_2 = read_image(im2_file, is_MRI=im2_isMRI)

pt1 = get_random_query_point(im1)

emb1 = get_embedding(normed_im1, model)
emb2 = get_embedding(normed_im2, model)

# Some embedding will be float16 (half)
# But CPU won't support some float16 operations in torch
# Convert them to float32
for i in range(3):
    emb1[i] = emb1[i].float()
    emb2[i] = emb2[i].float()


pt1_normed = np.array(pt1) * norm_info_1
pt2_normed, score = get_sim_embed_loc(
    emb1,
    emb2,
    pt1_normed,
    (im2["shape"][3], im2["shape"][1], im2["shape"][2]),
    norm_info=norm_info_2,
    write_sim=False,
    use_sim_coarse=True,
)
pt2 = np.array(pt2_normed).astype(int)

print(pt1, pt2)
